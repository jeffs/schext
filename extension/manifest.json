{
  "manifest_version": 3,
  "name": "Teacher Companion for Schoology",
  "version": "0.1.0",
  "description": "Sets the default due time of new Schoology assignments.",
  "content_scripts": [
    {
      "matches": [
        "https://*.schoology.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "permissions": [
    "storage"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
