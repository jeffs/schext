{
  "manifest_version": 3,
  "name": "Teacher Companion for Schoology",
  "version": "0.1.0",
  "description": "Sets the default due time of new Schoology assignments.",
  "icons": {
    "16": "icons/chalkboard-teacher-16.png",
    "32": "icons/chalkboard-teacher-32.png",
    "48": "icons/chalkboard-teacher-48.png",
    "128": "icons/chalkboard-teacher-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.schoology.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "options.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
